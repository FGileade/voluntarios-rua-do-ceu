/* Global feedback modal: shared by validation, status and confirmation flows. */
.global-feedback-layer {
  position: fixed;
  inset: 0;
  z-index: {{Z_INDEX}};
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: max(1rem, env(safe-area-inset-top))
           max(1rem, env(safe-area-inset-right))
           max(1rem, env(safe-area-inset-bottom))
           max(1rem, env(safe-area-inset-left));
  overflow-y: auto;
  overscroll-behavior: contain;
}

.global-feedback-backdrop {
  position: absolute;
  inset: 0;
  background: {{BACKDROP}};
  backdrop-filter: blur(6px);
  -webkit-backdrop-filter: blur(6px);
  animation: globalFeedbackBackdropIn 180ms ease-out both;
}

.global-feedback-dialog {
  position: relative;
  z-index: 1;
  width: min(100%, 32rem);
  max-height: calc(100dvh - 2rem);
  overflow-y: auto;
  box-sizing: border-box;
  border-width: 1px;
  border-radius: 1.25rem;
  background: linear-gradient(145deg, {{SURFACE_FROM}} 0%, {{SURFACE_TO}} 100%);
  color: #f8fafc;
  box-shadow: 0 24px 80px rgba(0, 0, 0, 0.55), 0 0 0 1px {{ACCENT_GLOW}};
  -webkit-overflow-scrolling: touch;
}

.global-feedback-dialog--entering {
  animation: globalFeedbackDialogIn 220ms cubic-bezier(0.16, 1, 0.3, 1) both;
}

.global-feedback-dialog--closing {
  animation: globalFeedbackDialogOut 180ms cubic-bezier(0.4, 0, 1, 1) both;
}

.global-feedback-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem;
  padding: 1rem 1rem 0.875rem;
  border-bottom: 1px solid rgba(148, 163, 184, 0.16);
  background: rgba(2, 6, 23, 0.42);
}

.global-feedback-brand {
  display: flex;
  align-items: center;
  min-width: 0;
  gap: 0.7rem;
}

.global-feedback-logo {
  width: 2.75rem;
  height: 2.75rem;
  flex: 0 0 auto;
  border: 2px solid {{ACCENT}};
  border-radius: 9999px;
  object-fit: cover;
  background: #fff;
}

.global-feedback-brand-name,
.global-feedback-brand-label {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.global-feedback-brand-name {
  color: #f8fafc;
  font-size: 0.8rem;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.global-feedback-brand-label {
  margin-top: 0.15rem;
  color: {{ACCENT_SOFT}};
  font-family: {{MONO_FONT}};
  font-size: 0.62rem;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

.global-feedback-close {
  display: inline-flex;
  min-width: 2.75rem;
  min-height: 2.75rem;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  border: 1px solid rgba(148, 163, 184, 0.25);
  border-radius: 0.75rem;
  color: #cbd5e1;
  cursor: pointer;
  transition: color 150ms ease, background-color 150ms ease, border-color 150ms ease;
}

.global-feedback-close:hover:not(:disabled) {
  border-color: rgba(248, 113, 113, 0.65);
  background: rgba(127, 29, 29, 0.35);
  color: #fff;
}

.global-feedback-close:disabled,
.global-feedback-button:disabled {
  cursor: not-allowed;
  opacity: 0.6;
}

.global-feedback-content {
  padding: 1.5rem 1.25rem 1.25rem;
  text-align: center;
}

.global-feedback-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 4.5rem;
  height: 4.5rem;
  margin-bottom: 0.8rem;
  border: 1px solid currentColor;
  border-radius: 9999px;
  background: rgba(15, 23, 42, 0.75);
  box-shadow: 0 0 28px currentColor;
  opacity: 0.95;
}

.global-feedback-type {
  display: block;
  margin-bottom: 0.4rem;
  font-family: {{MONO_FONT}};
  font-size: 0.68rem;
  font-weight: 800;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}

.global-feedback-title {
  margin: 0;
  color: #fff;
  font-size: clamp(1.15rem, 4vw, 1.45rem);
  font-weight: 800;
  line-height: 1.25;
}

.global-feedback-message {
  max-width: 30rem;
  margin: 0.7rem auto 0;
  color: #cbd5e1;
  font-size: 1rem;
  line-height: 1.55;
  white-space: pre-line;
  overflow-wrap: anywhere;
}

.global-feedback-actions {
  display: flex;
  justify-content: center;
  gap: 0.75rem;
  padding: 0 1.25rem 1.25rem;
}

.global-feedback-actions--confirmation > .global-feedback-button {
  flex: 1 1 0;
}

.global-feedback-button {
  display: inline-flex;
  min-height: 3rem;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  border-radius: 0.8rem;
  padding: 0.75rem 1rem;
  font-size: 0.95rem;
  font-weight: 800;
  cursor: pointer;
  transition: transform 150ms ease, background-color 150ms ease, border-color 150ms ease;
}

.global-feedback-button:hover:not(:disabled) {
  transform: translateY(-1px);
}

.global-feedback-button--primary {
  min-width: 9rem;
  border: 1px solid {{PRIMARY_HOVER}};
  background: {{PRIMARY}};
  color: #fff;
  box-shadow: 0 8px 20px {{PRIMARY_SHADOW}};
}

.global-feedback-button--primary:hover:not(:disabled) {
  background: {{PRIMARY_HOVER}};
}

.global-feedback-button--secondary {
  min-width: 8rem;
  border: 1px solid rgba(148, 163, 184, 0.45);
  background: rgba(15, 23, 42, 0.9);
  color: #e2e8f0;
}

.global-feedback-button--secondary:hover:not(:disabled) {
  border-color: {{ACCENT_HOVER_BORDER}};
  background: rgba(51, 65, 85, 0.85);
  color: #fff;
}

@keyframes globalFeedbackBackdropIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes globalFeedbackDialogIn {
  from { opacity: 0; transform: translateY(0.75rem) scale(0.97); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

@keyframes globalFeedbackDialogOut {
  from { opacity: 1; transform: translateY(0) scale(1); }
  to { opacity: 0; transform: translateY(0.5rem) scale(0.98); }
}

@media (max-width: 480px) {
  .global-feedback-layer {
    align-items: flex-end;
  }

  .global-feedback-dialog {
    width: 100%;
    border-radius: 1.25rem 1.25rem 1rem 1rem;
  }

  .global-feedback-actions {
    flex-direction: column-reverse;
  }

  .global-feedback-actions--confirmation > .global-feedback-button,
  .global-feedback-button--primary,
  .global-feedback-button--secondary {
    width: 100%;
  }
}

@media (prefers-reduced-motion: reduce) {
  .global-feedback-backdrop,
  .global-feedback-dialog--entering,
  .global-feedback-dialog--closing {
    animation: none;
  }

  .global-feedback-button:hover:not(:disabled) {
    transform: none;
  }
}

/* Brand loading overlay: tela cheia com a logo animada, para ações imediatas
   como login/cadastro (via showLoading/hideLoading/withLoading). */
.brand-loading-layer {
  position: fixed;
  inset: 0;
  z-index: {{Z_INDEX}};
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  pointer-events: none;
  transition: opacity 180ms ease;
}

.brand-loading-layer--visible {
  opacity: 1;
  pointer-events: auto;
}

.brand-loading-backdrop {
  position: absolute;
  inset: 0;
  background: {{BACKDROP}};
  backdrop-filter: blur(6px);
  -webkit-backdrop-filter: blur(6px);
}

.brand-loading-content {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1rem;
}

.brand-loading-ring {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 5.5rem;
  height: 5.5rem;
}

.brand-loading-ring::before {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: 9999px;
  border: 3px solid {{ACCENT_GLOW}};
  border-top-color: {{ACCENT}};
  animation: brandLoadingSpin 900ms linear infinite;
}

.brand-loading-logo {
  width: 3.5rem;
  height: 3.5rem;
  border-radius: 9999px;
  object-fit: cover;
  background: #fff;
  animation: brandLoadingPulse 1600ms ease-in-out infinite;
}

.brand-loading-message {
  margin: 0;
  color: #f8fafc;
  font-size: 0.95rem;
  font-weight: 700;
  letter-spacing: 0.02em;
  text-align: center;
}

@keyframes brandLoadingSpin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

@keyframes brandLoadingPulse {
  0%, 100% { transform: scale(1); opacity: 1; }
  50% { transform: scale(0.92); opacity: 0.8; }
}

@media (prefers-reduced-motion: reduce) {
  .brand-loading-ring::before,
  .brand-loading-logo {
    animation: none;
  }
}

